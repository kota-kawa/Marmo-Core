.git
# Local environment files hold API keys and must never enter the build context.
# .env.example is not needed in the image: the Dockerfile never copies it, and
# the repository checks that read it only run from a full checkout.
**/.env
**/.env.*
.agents
.codex
/resources/*
!/resources/memory/
!/resources/memory/**
!/resources/agents/
!/resources/agents/**
!/resources/tools/
!/resources/tools/**
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.md
!README.md
# Required by scripts/release_check.py, which the test suite runs.
!CHANGELOG.md
