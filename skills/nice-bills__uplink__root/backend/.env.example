# Agent Fundraising Platform - Backend Configuration
# Copy to .env and fill in required values

# === REQUIRED ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_fundraising
ADMIN_KEY=your-secure-admin-key-here
AGENT_API_KEY=your-secure-agent-api-key-at-least-32-chars-long

# === OPTIONAL ===
FRONTEND_URL=https://uplink-genesis.vercel.app
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
X402_API_KEY=
X402_API_URL=https://api.x402.dev
SAFE_API_URL=https://safe-client.safe.global
