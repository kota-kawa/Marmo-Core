# Genesis Frontend Environment Variables

# WalletConnect Project ID
# Get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id

# API URL (backend)
# Local dev:
VITE_API_URL=http://localhost:8000
# Production on Vercel: omit VITE_API_URL to use the /api proxy in vercel.json,
# or set VITE_API_URL=https://genesis-backend.onrender.com for direct calls.
