# Genesis Platform Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./genesis.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost/genesis

# Monad Blockchain
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Platform Settings
PLATFORM_API=http://localhost:8000
# Production: PLATFORM_API=https://genesis-backend.onrender.com
ENCRYPTION_KEY=your_32_byte_encryption_key_here_generate_with_python_secrets

# Contract Addresses (Monad Testnet)
AGENT_REGISTRY_ADDRESS=0x3f4D1B21251409075a0FB8E1b0C0A30B23f05653
PLATFORM_FEE_MANAGER_ADDRESS=0x77107B62a9149F0073F40846af477fa6f9E3543A
CAMPAIGN_FACTORY_ADDRESS=0xbEC03ac2Fda75cbb5c7f0c510d75F5d48C68AfE0
MULTISIG_TREASURY_ADDRESS=0x...

# Genesis Bot Wallet (your wallet address that acts as signer)
GENESIS_BOT_ADDRESS=0x...
GENESIS_BOT_PRIVATE_KEY=0x...

# ============================================
# FRONTEND CONFIGURATION
# ============================================

NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0x3f4D1B21251409075a0FB8E1b0C0A30B23f05653
NEXT_PUBLIC_PLATFORM_FEE_MANAGER=0x77107B62a9149F0073F40846af477fa6f9E3543A
NEXT_PUBLIC_CAMPAIGN_FACTORY=0xbEC03ac2Fda75cbb5c7f0c510d75F5d48C68AfE0
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ============================================
# TWITTER BOT CONFIGURATION
# ============================================

# Your Genesis bot Twitter credentials
TWITTER_USERNAME=your_genesis_bot_handle
TWITTER_PASSWORD=your_bot_password
# TWITTER_EMAIL=your_bot_email  # Optional, for verification

# Cookie file location (auto-generated after first login)
TWITTER_COOKIES_FILE=twitter_cookies.json

# ============================================
# MOLTBOOK INTEGRATION (Optional)
# ============================================

MOLTBOOK_API_URL=https://api.moltbook.com
MOLTBOOK_API_KEY=your_moltbook_api_key

# ============================================
# PRIVY CONFIGURATION (Optional - for embedded wallets)
# ============================================

PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_WALLET_API_URL=https://api.privy.io/v1

# ============================================
# OPTIONAL: THIRD PARTY SERVICES
# ============================================

# For price feeds (optional)
CHAINLINK_PRICE_FEED=0x...

# For notifications (optional)
WEBHOOK_URL=https://your-webhook.com/notify

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

DEBUG=true
LOG_LEVEL=INFO

# Auto-reload on code changes (development only)
RELOAD=true
