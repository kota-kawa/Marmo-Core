{
  "Comment": "A simple AWS Step Functions state machine example for image processing workflow",
  "StartAt": "ValidateInput",
  "States": {
    "ValidateInput": {
      "Type": "Pass",
      "Comment": "Validate input parameters",
      "Next": "CheckImageFormat"
    },
    "CheckImageFormat": {
      "Type": "Choice",
      "Comment": "Check if image format is supported",
      "Choices": [
        {
          "Variable": "$.imageFormat",
          "StringEquals": "jpg",
          "Next": "ProcessJPEG"
        },
        {
          "Variable": "$.imageFormat",
          "StringEquals": "png",
          "Next": "ProcessPNG"
        }
      ],
      "Default": "UnsupportedFormat"
    },
    "ProcessJPEG": {
      "Type": "Task",
      "Comment": "Process JPEG image",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ProcessJPEG",
      "Next": "ResizeImage",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ProcessingFailed"
        }
      ]
    },
    "ProcessPNG": {
      "Type": "Task",
      "Comment": "Process PNG image",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ProcessPNG",
      "Next": "ResizeImage",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ProcessingFailed"
        }
      ]
    },
    "ResizeImage": {
      "Type": "Task",
      "Comment": "Resize image to thumbnail",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ResizeImage",
      "Next": "CheckQuality"
    },
    "CheckQuality": {
      "Type": "Choice",
      "Comment": "Check image quality score",
      "Choices": [
        {
          "Variable": "$.qualityScore",
          "NumericGreaterThan": 80,
          "Next": "UploadToS3"
        }
      ],
      "Default": "LowQualityWarning"
    },
    "LowQualityWarning": {
      "Type": "Pass",
      "Comment": "Log low quality warning",
      "Next": "UploadToS3"
    },
    "UploadToS3": {
      "Type": "Task",
      "Comment": "Upload processed image to S3",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Next": "NotifySuccess"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Comment": "Send success notification",
      "Resource": "arn:aws:states:::sns:publish",
      "Next": "ProcessingComplete"
    },
    "ProcessingComplete": {
      "Type": "Succeed",
      "Comment": "Image processing completed successfully"
    },
    "UnsupportedFormat": {
      "Type": "Fail",
      "Comment": "Image format not supported",
      "Error": "UnsupportedImageFormat",
      "Cause": "Only JPEG and PNG formats are supported"
    },
    "ProcessingFailed": {
      "Type": "Fail",
      "Comment": "Image processing failed",
      "Error": "ProcessingError",
      "Cause": "An error occurred during image processing"
    }
  }
}
