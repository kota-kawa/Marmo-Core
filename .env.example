# Local API credentials. Values set in the operating-system environment take
# precedence over this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Runtime model selection.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional model-backed benchmark selection.
BENCHMARK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BENCHMARK_CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
