# Local API credentials. Values set in the operating-system environment take
# precedence over this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Runtime model selection.
OPENAI_MODEL=gpt-5.6-terra
# Provider-specific; leave empty to omit `reasoning_effort` from the request.
# OpenAI accepts none/low/medium/high, Groq's gpt-oss only low/medium/high —
# sending `none` to Groq fails the first request with HTTP 400.
OPENAI_REASONING_EFFORT=
# Any OpenAI-compatible endpoint; leave empty for api.openai.com. For Groq set
# all three of these: OPENAI_BASE_URL=https://api.groq.com/openai/v1,
# OPENAI_MODEL=openai/gpt-oss-120b, and OPENAI_API_KEY to the Groq key (Groq
# reads the key from OPENAI_API_KEY, there is no separate GROQ_API_KEY here).
OPENAI_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional model-backed benchmark selection.
BENCHMARK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BENCHMARK_CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Webhook targets for the bundled `send-notification` Tool sample. One
# variable per destination alias, HTTPS only; the URL never appears in tool
# arguments or audit records. For destination `ops`, set
# MARMO_NOTIFICATION_OPS_URL. Uncomment and fill in the aliases you use.
# MARMO_NOTIFICATION_<DESTINATION>_URL=
