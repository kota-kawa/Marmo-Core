# Local API credentials. Values set in the operating-system environment take
# precedence over this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Runtime model selection.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
# Any OpenAI-compatible endpoint; leave empty for api.openai.com. For example
# Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1 with
# OPENAI_MODEL=openai/gpt-oss-120b and OPENAI_API_KEY set to the Groq key.
OPENAI_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional model-backed benchmark selection.
BENCHMARK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BENCHMARK_CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
